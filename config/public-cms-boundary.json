{
  "repository": "erg",
  "owner": "ERG Public CMS",
  "ownedScopes": [
    "src/app/@main",
    "src/app/@cms",
    "src/components/cms",
    "src/components/forum",
    "src/services"
  ],
  "forbiddenOperationalScopes": [
    "src/features/lms",
    "src/features/lcms",
    "src/features/crm",
    "src/features/elearning"
  ],
  "routes": [
    { "path": "/", "source": "src/app/page.tsx" },
    { "path": "/tin-tuc", "source": "src/app/@main/tin-tuc/page.tsx" },
    { "path": "/cms/posts", "source": "src/app/@cms/(dashboard)/cms/posts/page.tsx" },
    { "path": "/robots.txt", "source": "src/app/robots.ts" }
  ],
  "apiRoutes": [
    { "path": "/api/preview", "source": "src/app/api/preview/route.ts" },
    { "path": "/api/rss", "source": "src/app/api/rss/route.ts" },
    { "path": "/api/*", "source": "src/app/api/[...path]/route.ts" }
  ],
  "smokePaths": [
    { "path": "/", "statuses": [200] },
    { "path": "/tin-tuc", "statuses": [200] },
    { "path": "/robots.txt", "statuses": [200] }
  ],
  "bundle": {
    "directory": ".next/static/chunks",
    "maxTotalJsBytes": 8200000,
    "maxChunkJsBytes": 800000
  }
}
