---
interface Props { eyebrow: string; title: string }
const { eyebrow, title } = Astro.props;
---
<div class="head">
  <span class="pill">{eyebrow}</span>
  <h2>{title}</h2>
  <slot />
</div>
<style>
  .head { display: flex; flex-direction: column; gap: 14px; max-width: 640px; }
  .pill { display: inline-flex; align-self: flex-start; padding: 6px 14px; border-radius: 999px; background: var(--red-soft); color: var(--red-deep); font-size: 13.5px; font-weight: 700; }
  h2 { margin: 0; font-size: 42px; line-height: 1.15; font-weight: 700; letter-spacing: -1px; text-wrap: balance; }
  .head :global(p) { margin: 0; font-size: 17px; line-height: 1.7; color: #4A5578; }
  @media (max-width: 767px) { h2 { font-size: 24px; } }
</style>
