---
import ProgramLayout from '@/components/program/ProgramLayout.astro';
import { PROGRAMS, CONTACT } from '@/data/site';
import { GROUPS, WHY_ICONS, programOf } from '@/data/programs';

export function getStaticPaths() {
  return PROGRAMS.map((p) => ({ params: { nhom: p.slug } }));
}
const { nhom } = Astro.params;
const p = programOf(nhom!);
const g = GROUPS[nhom!];
const base = `/chuong-trinh/${nhom}`;
const first = `${base}/khoa-hoc/${g.courses[0].slug}`;
const arrow = 'M5 12h14 M13 6l6 6l-6 6';
---
<ProgramLayout
  title={`${p.title} – ${p.short}`} description={p.text} nhom={nhom!} firstCourse={g.courses[0].slug} current="overview"
  crumbs={[{ label: 'Trang chủ', href: '/' }, { label: 'Chương trình', href: '/linh-vuc-dao-tao' }, { label: p.title }]}
  heading={p.title} lead={p.text} topic={g.topic} sceneMobile
>
  <div slot="actions" class="pg-actions">
    <a class="btn btn--primary" href={first} style="height: 52px; padding: 0 28px">Xem các khóa học
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" class="pg-arrow" style="stroke-width: 2.2"><path d={arrow}></path></svg></a>
    <a class="btn btn--glass only-desktop" href="/lien-he" style="height: 52px">Đăng ký tư vấn</a>
  </div>

  <div class="chips-w">
    <div class="chips">
      <span class="chips-l">Nhóm chương trình</span>
      {PROGRAMS.map((x) => (
        <a href={`/chuong-trinh/${x.slug}`} aria-current={x.slug === nhom ? 'page' : undefined}>{x.title}</a>
      ))}
    </div>
  </div>

  <section class="pg-sec">
    <div class="pg-wrap">
      <div class="pg-head">
        <span class="pg-pill">{g.whyEyebrow}</span>
        <h2 class="pg-h2">{g.whyTitle}</h2>
        <p class="pg-p clamp-3">{g.whyText}</p>
      </div>
      <div class="pg-grid pg-c4">
        {g.why.map((w, i) => (
          <div class="pg-card">
            <span class="pg-ico"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d={WHY_ICONS[i % WHY_ICONS.length]}></path></svg></span>
            <div class="pg-body">
              <h3 class="pg-ct">{w.title}</h3>
              <p class="pg-cd clamp-2">{w.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="pg-panel-o">
    <div class="pg-panel">
      <div class="pg-wrap">
        <div class="pg-head-row">
          <div class="pg-head">
            <span class="pg-pill">Khóa học trong nhóm</span>
            <h2 class="pg-h2">{g.coursesTitle}</h2>
          </div>
          <a class="pg-more-link only-desktop" href={first}>Xem tất cả khóa học
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" class="pg-arrow" style="stroke-width: 2.2"><path d={arrow}></path></svg></a>
        </div>
        <div class="rail">
          {g.courses.map((c) => (
            <a class="course" href={`${base}/khoa-hoc/${c.slug}`}>
              <div class="pg-ph" role="img" aria-label={c.photo}><span>{c.photo}</span></div>
              <div class="course-b">
                <span class="pg-tag">{c.level}</span>
                <h3 class="pg-ct" style="font-size: 20px; line-height: 1.3">{c.title}</h3>
                <p class="pg-cd clamp-2" style="flex: 1">{c.text}</p>
                <span style="font-size: 13px; font-weight: 600; color: #2C3560">{c.facts}</span>
                <span class="pg-link">Xem chi tiết
                  <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" class="pg-arrow" style="stroke-width: 2.2"><path d={arrow}></path></svg></span>
              </div>
            </a>
          ))}
        </div>
        <a class="pg-more only-mobile" href={first}>Xem tất cả khóa học</a>
      </div>
    </div>
  </section>

  <section class="pg-sec">
    <div class="pg-wrap">
      <div class="pg-head-row">
        <div class="pg-head">
          <span class="pg-pill">Lộ trình học</span>
          <h2 class="pg-h2">{g.stepsTitle}</h2>
          <p class="pg-p clamp-3" style="line-height: 1.7">{g.stepsText}</p>
        </div>
        <a class="pg-more-link only-desktop" href={`${base}/lo-trinh`}>Xem lộ trình chi tiết</a>
      </div>
      <div class="pg-grid pg-c4">
        {g.steps.map((s, i) => (
          <div class="pg-card">
            <span class="pg-ico pg-ico--round">{i + 1}</span>
            <div class="pg-body">
              <span class="pg-month">{s.month}</span>
              <h3 class="pg-ct">{s.title}</h3>
              <p class="pg-cd clamp-2">{s.text}</p>
            </div>
          </div>
        ))}
      </div>
      <a class="pg-more only-mobile" href={`${base}/lo-trinh`}>Xem lộ trình chi tiết</a>
    </div>
  </section>

  <section class="pg-panel-o">
    <div class="pg-panel">
      <div class="pg-row">
        <div class="pg-half pg-half-text">
          <span class="pg-pill">{g.certsTitle}</span>
          <h2 class="pg-h2">{g.certsHeading}</h2>
          <p class="pg-p clamp-3">{g.certsText}</p>
          <a class="pg-link" href={first} style="align-self: flex-start; font-size: 15px; min-height: 44px">Xem cấu trúc kỳ thi
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" class="pg-arrow" style="stroke-width: 2.2"><path d={arrow}></path></svg></a>
        </div>
        <div class="pg-half certs">
          {g.certs.map((c) => (
            <div class="cert">
              <span class="cert-i"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" class="pg-arrow"><path d={WHY_ICONS[0]}></path></svg></span>
              <div style="display: flex; flex-direction: column; gap: 4px; min-width: 0">
                <h3 class="pg-ct">{c.title}</h3>
                <p class="pg-cd clamp-2" style="line-height: 1.55">{c.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="pg-cta-o">
    <div class="pg-cta">
      <div class="pg-cta-t">
        <h2 class="pg-h2">{g.ctaTitle}</h2>
        <p class="clamp-3">{g.ctaText}</p>
      </div>
      <div class="pg-actions" style="margin: 0">
        <a class="pg-btn-w" href="/lien-he">Đăng ký tư vấn</a>
        <a class="btn btn--glass" href={`tel:${CONTACT.hotlineTel}`} style="padding: 0 26px">Gọi {CONTACT.hotline}</a>
      </div>
    </div>
  </section>
</ProgramLayout>

<style>
  .chips-w { padding: 28px 0 0; }
  .chips { max-width: 1200px; margin: 0 auto; padding: 0 var(--pad-x); display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; }
  .chips-l { flex: none; font-size: 13px; font-weight: 700; letter-spacing: 0.4px; color: #4A5578; }
  .chips a { flex: none; display: inline-flex; align-items: center; height: 44px; padding: 0 18px; border-radius: 999px; box-shadow: inset 0 0 0 1px #B9C0D8; background: #FFFFFF; color: #0F1738; font-size: 14px; font-weight: 600; white-space: nowrap; }
  .chips a[aria-current='page'] { box-shadow: none; background: var(--navy); color: #FFFFFF; }
  .rail { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .course { box-sizing: border-box; display: flex; flex-direction: column; border-radius: 32px; padding: 10px; background: #FFFFFF; color: #0F1738; box-shadow: var(--pg-shadow); }
  .course-b { padding: 20px 16px 18px; display: flex; flex-direction: column; gap: 12px; flex: 1; }
  .certs { display: flex; flex-direction: column; gap: var(--pg-grid); }
  .cert { display: flex; align-items: center; gap: var(--pg-card-gap); padding: var(--pg-card-pad); border-radius: 24px; background: #FFFFFF; box-shadow: 0 1px 2px rgba(15,23,56,0.04), 0 18px 36px -24px rgba(15,23,56,0.2); }
  .cert-i { flex: none; width: var(--pg-icon); height: var(--pg-icon); border-radius: 16px; background: linear-gradient(145deg, var(--red-soft-2) 0%, var(--red-soft) 100%); color: var(--red); display: inline-flex; align-items: center; justify-content: center; box-shadow: inset 0 1px 0 #FFFFFF, 0 10px 18px -12px color-mix(in srgb, var(--red) 50%, transparent); }
  @media (max-width: 767px) {
    .chips { flex-wrap: nowrap; overflow-x: auto; }
    .rail { display: flex; overflow-x: auto; gap: 14px; padding-bottom: 44px; margin-bottom: -44px; }
    .course { flex: none; width: 280px; }
  }
</style>
