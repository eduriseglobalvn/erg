---
import { KEYWORDS, FIELD_PROGRAM } from '@/data/seo';
import Base from '@/layouts/Base.astro';
import FieldHero from '@/components/fields/FieldHero.astro';
import SectionHead from '@/components/fields/SectionHead.astro';
import { FIELDS, CONTACT } from '@/data/site';
import { FIELD_DETAILS } from '@/data/fieldDetails';

export function getStaticPaths() {
  return FIELDS.map((field) => ({ params: { slug: field.slug }, props: { field } }));
}

const { field } = Astro.props;
const d = FIELD_DETAILS[field.slug];
const related = FIELDS.filter((f) => f.group === field.group && f.slug !== field.slug).slice(0, 3);
const arrow = 'M5 12h14 M13 6l6 6l-6 6';
const check = 'M5 12l5 5l9-10';
---
<Base title={d.h1} keywords={KEYWORDS[FIELD_PROGRAM[field.slug] ?? 'main']} description={field.text} active="programs">
  <FieldHero
    crumbs={[{ label: 'Trang chủ', href: '/' }, { label: 'Lĩnh vực đào tạo', href: '/linh-vuc-dao-tao' }, { label: field.title }]}
    badge={d.badge}
    title={d.h1}
    text={field.text}
    topic={field.slug === 'mos' ? 'mos3' : 'all'}
  />

  <section class="sec">
    <div class="wrap layout">
      <div class="main">
        <div class="feat">
          <div class="feat-txt">
            <SectionHead eyebrow="Tổng quan" title={d.heading}>
              <p class="clamp-4 lead-p">{d.overview}</p>
            </SectionHead>
            <ul class="checks">
              {d.highlights.map((h) => (
                <li><svg class="red" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d={check} /></svg><span class="clamp-2">{h}</span></li>
              ))}
            </ul>
          </div>
          <div class="feat-img only-desktop">
            <div class="ph photo" role="img" aria-label={d.photoAlt}><span>{d.photoLabel}</span></div>
          </div>
        </div>

        <div class="block">
          <SectionHead eyebrow="Đối tượng" title={`Ai nên học ${field.title}?`} />
          <div class="grid3">
            {d.audience.map((a) => (
              <div class="box">
                <span class="ico"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M12 3a4 4 0 1 0 0 8a4 4 0 0 0 0-8z M4 21a8 8 0 0 1 16 0" /></svg></span>
                <p class="clamp-2 plain">{a}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="block">
          <SectionHead eyebrow="Nội dung học" title="Bạn sẽ học những gì?" />
          <div class="grid3">
            {d.modules.map((m, i) => (
              <div class="box">
                <span class="no">{i + 1}</span>
                <div class="txt">
                  <h3>{m.title}</h3>
                  <p class="clamp-2 muted">{m.text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="block">
          <SectionHead eyebrow="Kết quả & chứng chỉ" title="Sau khóa học" />
          <div class="grid2">
            <div class="box col">
              <ul class="checks">
                {d.outcomes.map((o) => (
                  <li><svg class="blue" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d={check} /></svg><span class="clamp-2">{o}</span></li>
                ))}
              </ul>
            </div>
            <div class="assess">
              <h3>Đánh giá &amp; chuẩn đầu ra</h3>
              <p class="clamp-3">{d.assessment}</p>
            </div>
          </div>
        </div>

        <div class="block">
          <SectionHead eyebrow="Câu hỏi thường gặp" title="Giải đáp nhanh" />
          <div class="faq">
            {d.faq.map((item, i) => (
              <details open={i === 0 ? true : undefined} data-faq={i === 0 ? 'first' : undefined}>
                <summary>{item.q}
                  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 9l6 6l6-6" /></svg></summary>
                <p>{item.a}</p>
              </details>
            ))}
          </div>
        </div>
      </div>

      <aside>
        <h2>Thông tin chương trình</h2>
        <dl>
          {d.facts.map((f) => (<div class="fact"><dt>{f.k}</dt><dd>{f.v}</dd></div>))}
        </dl>
        <form data-static-form>
          <h3>Đăng ký tư vấn miễn phí</h3>
          <div class="fld">
            <label for="fd-name">Họ tên</label>
            <input id="fd-name" name="name" type="text" autocomplete="name" placeholder="Nguyễn Văn A" />
          </div>
          <div class="fld">
            <label for="fd-phone">Số điện thoại</label>
            <input id="fd-phone" name="phone" type="tel" autocomplete="tel" placeholder="09xx xxx xxx" />
            <span class="note only-desktop">ERG chỉ dùng số điện thoại để liên hệ tư vấn.</span>
          </div>
          <div class="fld">
            <label for="fd-program">Chương trình quan tâm</label>
            <select id="fd-program" name="program">
              {FIELDS.map((f) => (<option selected={f.slug === field.slug}>{f.title}</option>))}
            </select>
          </div>
          <p data-form-note hidden tabindex="-1" role="status" class="form-note">Chức năng gửi trực tuyến đang được hoàn thiện. Vui lòng gọi hotline 0938.830.098 hoặc email info@erg.edu.vn.</p>
          <button type="submit" class="submit">Đăng ký tư vấn</button>
          <a class="zalo" href="https://zalo.me/0938830098">Hoặc nhắn Zalo {CONTACT.hotline}</a>
        </form>
      </aside>
    </div>
  </section>

  <section class="panel-wrap">
    <div class="panel">
      <div class="wrap stack in">
        <div class="rel-head">
          <SectionHead eyebrow="Gợi ý cho bạn" title="Lĩnh vực liên quan" />
          <a class="more only-desktop" href="/linh-vuc-dao-tao">Xem tất cả
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d={arrow} /></svg></a>
        </div>
        <div class="grid3 rel">
          {related.map((f) => (
            <a class="card" href={`/linh-vuc-dao-tao/${f.slug}`}>
              <span class="ico ico--red"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d={f.icon} /></svg></span>
              <div class="txt">
                <h3>{f.title}</h3>
                <p class="clamp-2 muted grow">{f.text}</p>
                <span class="go only-desktop">Xem chương trình
                  <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d={arrow} /></svg></span>
              </div>
            </a>
          ))}
        </div>
        <a class="more only-mobile" href="/linh-vuc-dao-tao">Xem tất cả
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d={arrow} /></svg></a>
      </div>
    </div>
  </section>
</Base>

<script>
  // design: first FAQ open on desktop, all closed on mobile
  if (matchMedia('(max-width: 767px)').matches) document.querySelector('details[data-faq="first"]')?.removeAttribute('open');
</script>

<style>
  .sec { padding: 88px 0; }
  .wrap { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .layout { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 40px 56px; }
  .main { flex: 2 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 56px; }
  .block, .stack { display: flex; flex-direction: column; gap: 40px; }
  .feat { display: flex; align-items: center; gap: 32px; }
  .feat-txt { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; gap: 16px; }
  .feat-txt :global(.lead-p) { font-size: 17px; line-height: 1.75; }
  .feat-img { flex: 1 1 0; min-width: 0; }
  .photo { aspect-ratio: 1 / 1; border-radius: 32px; box-sizing: border-box; background: linear-gradient(150deg, var(--soft) 0%, var(--tint-2) 100%); border: 1px dashed #9AA3C7; }
  .photo span { font-size: 13px; color: #2C3560; background: #fff; padding: 6px 12px; border-radius: 999px; }
  .checks { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .checks li { display: flex; gap: 12px; align-items: flex-start; font-size: 16px; line-height: 1.65; color: #0F1738; }
  .checks svg, .more svg, .go svg, .ico svg, summary svg { fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; }
  .checks svg { flex: none; margin-top: 2px; stroke-width: 2.2; }
  .red { color: var(--red); } .blue { color: var(--navy); }
  .grid3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .grid2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .box { display: flex; gap: 16px; padding: 24px; border-radius: 28px; background: #fff; box-shadow: 0 1px 2px rgba(15,23,56,0.04), 0 18px 36px -24px rgba(15,23,56,0.2); flex-direction: column; }
  .box.col { flex-direction: column; }
  .ico { flex: none; width: 52px; height: 52px; border-radius: 16px; display: inline-flex; align-items: center; justify-content: center; background: linear-gradient(145deg, var(--accent) 0%, var(--navy) 100%); color: #fff; box-shadow: 0 12px 20px -10px color-mix(in srgb, var(--navy) 70%, transparent), inset 0 1px 0 rgba(255,255,255,0.4); }
  .ico svg { stroke-width: 1.9; }
  .ico--red { background: linear-gradient(145deg, var(--red-soft-2) 0%, var(--red-soft) 100%); color: var(--red); box-shadow: inset 0 1px 0 #fff, 0 10px 18px -12px color-mix(in srgb, var(--red) 50%, transparent); }
  .no { flex: none; width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(145deg, var(--accent) 0%, var(--navy) 100%); color: #fff; display: inline-flex; align-items: center; justify-content: center; font-weight: 700; font-size: 15px; box-shadow: 0 12px 20px -10px color-mix(in srgb, var(--navy) 70%, transparent), inset 0 1px 0 rgba(255,255,255,0.4); }
  .txt { display: flex; flex-direction: column; gap: 10px; flex: 1; min-width: 0; }
  h3 { margin: 0; font-size: 17px; font-weight: 700; line-height: 1.3; letter-spacing: -0.2px; }
  p { margin: 0; }
  .plain { font-size: 16px; line-height: 1.65; color: #0F1738; }
  .muted { font-size: 16px; line-height: 1.65; color: #4A5578; }
  .grow { flex: 1; }
  .assess { padding: 24px; border-radius: 28px; background: linear-gradient(145deg, var(--tint-4) 0%, var(--soft) 100%); }
  .assess h3 { margin-bottom: 8px; color: var(--navy); }
  .assess p { font-size: 16px; line-height: 1.7; color: #2C3560; }
  .faq { display: flex; flex-direction: column; gap: 12px; }
  details { border-radius: 22px; background: #fff; box-shadow: 0 1px 2px rgba(15,23,56,0.04), 0 18px 36px -24px rgba(15,23,56,0.2); }
  summary { list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 56px; padding: 12px 24px; cursor: pointer; font-size: 16px; font-weight: 700; color: #0F1738; }
  summary::-webkit-details-marker { display: none; }
  summary svg { flex: none; stroke-width: 2.2; transition: transform .2s; }
  details[open] summary { color: var(--navy); }
  details[open] summary svg { transform: rotate(180deg); }
  details p { padding: 0 24px 22px; font-size: 16px; line-height: 1.7; color: #4A5578; }
  aside { flex: 1 1 340px; max-width: 420px; min-width: 0; display: flex; flex-direction: column; gap: 16px; padding: 30px 28px; border-radius: 32px; background: #fff; box-shadow: 0 1px 2px rgba(15,23,56,0.04), 0 28px 56px -28px rgba(15,23,56,0.22); }
  aside h2 { margin: 0; font-size: 20px; font-weight: 700; letter-spacing: -0.3px; }
  dl { margin: 0; display: flex; flex-direction: column; }
  .fact { display: flex; justify-content: space-between; gap: 16px; padding: 12px 0; border-top: 1px solid #EEF1F7; font-size: 14.5px; }
  dt { margin: 0; color: #4A5578; }
  dd { margin: 0; font-weight: 600; text-align: right; }
  form { display: flex; flex-direction: column; gap: 16px; padding-top: 20px; border-top: 1px solid #EEF1F7; }
  .fld { display: flex; flex-direction: column; gap: 6px; }
  label { font-size: 13.5px; font-weight: 600; }
  input, select { height: 54px; padding: 0 16px; border: 1px solid #D5DAE8; border-radius: 16px; font-family: inherit; font-size: 15.5px; color: #0F1738; background: #fff; box-sizing: border-box; width: 100%; }
  .note { font-size: 12.5px; color: #4A5578; }
  .form-note { padding: 12px 16px; border-radius: 16px; background: var(--tint-4); color: #2C3560; font-size: 14px; line-height: 1.6; }
  .submit { height: 54px; border: 0; border-radius: 999px; background: var(--cta, var(--red)); color: var(--cta-text, #fff); font-family: inherit; font-weight: 700; font-size: 16px; cursor: pointer; box-shadow: 0 18px 32px -14px var(--cta, var(--red)), inset 0 1px 0 rgba(255,255,255,0.35); }
  .zalo { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; border-radius: 999px; background: #fff; color: var(--navy); font-weight: 600; font-size: 15px; text-decoration: none; box-shadow: 0 1px 2px rgba(15,23,56,0.06), 0 14px 28px -18px rgba(15,23,56,0.3); }
  .panel-wrap { padding: 0 24px 88px; }
  .panel { max-width: 1360px; margin: 0 auto; border-radius: 48px; background: linear-gradient(180deg, var(--tint-3) 0%, #F7F8FC 100%); padding: 88px 0; }
  .in { padding: 0 24px; }
  .rel-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px; }
  .more { display: inline-flex; align-items: center; justify-content: center; gap: 6px; height: 50px; padding: 0 24px; border-radius: 999px; background: #fff; font-size: 15px; font-weight: 700; color: var(--navy); text-decoration: none; box-shadow: 0 1px 2px rgba(15,23,56,0.06), 0 14px 28px -18px rgba(15,23,56,0.3); }
  .more svg { stroke-width: 2.2; }
  .rel { gap: 20px; }
  .card { display: flex; flex-direction: column; gap: 16px; padding: 28px; border-radius: 28px; background: #fff; text-decoration: none; color: #0F1738; box-shadow: 0 1px 2px rgba(15,23,56,0.04), 0 28px 56px -28px rgba(15,23,56,0.22); }
  .go { display: inline-flex; align-items: center; gap: 6px; font-size: 13.5px; font-weight: 700; color: var(--navy); margin-top: 4px; }
  .go svg { stroke-width: 2.2; }

  @media (max-width: 767px) {
    .sec { padding: 40px 0; }
    .wrap { padding: 0 16px; }
    .main { gap: 32px; }
    .block, .stack { gap: 24px; }
    .feat { flex-direction: column; gap: 16px; }
    .grid3, .grid2, .rel { grid-template-columns: 1fr; gap: 12px; }
    .box { flex-direction: row; align-items: flex-start; padding: 16px; border-radius: 22px; gap: 14px; }
    .box.col { flex-direction: column; }
    .ico { width: 44px; height: 44px; }
    .txt { gap: 4px; }
    .assess { padding: 16px; border-radius: 22px; }
    aside { padding: 18px 16px; }
    .fact { padding: 8px 0; }
    .panel-wrap { padding: 0 8px 40px; }
    .panel { border-radius: 32px; padding: 40px 0; }
    .in { padding: 0 14px; }
    .card { flex-direction: row; align-items: flex-start; padding: 16px; border-radius: 22px; gap: 14px; }
    .more.only-mobile { width: 100%; box-sizing: border-box; }
  }
</style>
